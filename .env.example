# Variables documentées : ce fichier n'est pas chargé automatiquement.
ONCO_WORKSPACE=./workspace
ONCO_HOST=127.0.0.1
ONCO_PORT=8010
# Obligatoire pour collecter/modifier depuis l'API ; >=24 caractères.
ONCO_ADMIN_TOKEN=
# Lecture publique des données de démonstration par défaut.
ONCO_PRIVATE=0
# Pour collecter via NCBI : votre véritable adresse de contact.
NCBI_EMAIL=
NCBI_API_KEY=
